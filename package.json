{
  "name": "rag-learning",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "usecases/*"
  ],
  "scripts": {
    "chroma": "chroma run --path ./.chroma",
    "uc1:ingest": "tsx usecases/uc1-gpo/src/ingest.ts",
    "uc1:query": "tsx usecases/uc1-gpo/src/query.ts",
    "uc1:eval": "tsx usecases/uc1-gpo/src/eval.ts",
    "uc2:ingest": "tsx usecases/uc2-gep/src/ingest.ts",
    "uc2:query": "tsx usecases/uc2-gep/src/query.ts",
    "uc2:eval": "tsx usecases/uc2-gep/src/eval.ts",
    "uc3:ingest": "tsx usecases/uc3-imac/src/ingest.ts",
    "uc3:query": "tsx usecases/uc3-imac/src/query.ts",
    "uc3:eval": "tsx usecases/uc3-imac/src/eval.ts",
    "offline:bm25": "tsx scripts/offline-bm25.ts",
    "verify:gold": "tsx scripts/verify-gold.ts",
    "viewer": "tsx scripts/viewer/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@langchain/core": "^1.2.18",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.5.1",
    "chromadb": "^3.5.0",
    "dotenv": "^18.0.8",
    "js-tiktoken": "^1.0.21",
    "minisearch": "^7.2.0",
    "mupdf": "^1.28.1",
    "open": "^11.0.4",
    "voyageai": "^0.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
