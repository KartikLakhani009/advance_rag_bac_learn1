# --- Environment ---
APP_ENV=development                       # development | production (controls defaults, e.g. rerank)

# --- Groq (text) ---
GROQ_API_KEY=
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_ANSWER=openai/gpt-oss-20b      # escalation: openai/gpt-oss-120b
GROQ_RPM=30
# per-use-case answer model override (escalation only, with a documented failing case); empty = GROQ_MODEL_ANSWER
GROQ_MODEL_ANSWER_UC1=
GROQ_MODEL_ANSWER_UC2=
GROQ_MODEL_ANSWER_UC3=

# --- Gemini (vision, listed pages only) ---
GEMINI_API_KEY=
GEMINI_MODEL_VISION=                      # a Flash-Lite model ID; escalate to Flash only if eval fails
GEMINI_RPM=10

# --- Voyage AI (embeddings + production rerank) ---
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-4-lite
VOYAGE_RERANK_MODEL=rerank-2.5-lite
VOYAGE_RPM=3                              # very low without a payment method on file
VOYAGE_TPM=10000

# --- Chroma (local) ---
CHROMA_URL=http://localhost:8000

# --- Retrieval ---
SHORTLIST_K=20                            # candidates from each of dense and BM25
FINAL_K=5                                 # passages kept after fusion/rerank
RRF_K=2                                   # score = 1/(RRF_K + rank), rank from 0; try 60 (original paper) in the ladder
RERANK_ENABLED=                           # optional override: true | false. Empty = APP_ENV default (dev: false, prod: true)

# --- UC3 index variant ---
UC3_VARIANT=final                         # final (flat, default) | rows (small-to-big experiment)

# --- Reliability ---
MAX_RETRIES=5
LOG_LEVEL=info
